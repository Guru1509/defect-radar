# DEFECTRADAR Environment Configuration
# Copy this file to .env and customize as needed.

# Data Paths (Defaults relative to project root)
DATA_RAW_DIR=data/raw
DATA_EXTRACTED_DIR=data/extracted
DATA_PROCESSED_DIR=data/processed
DATA_EMBEDDINGS_DIR=data/embeddings

# System Constraints (Optimized for Apple Silicon M2, 8GB RAM)
CHUNK_SIZE=50000
MAX_MEMORY_USAGE_MB=4096
NUM_WORKERS=2

# Logging & Environment
LOG_LEVEL=INFO
ENV_MODE=development
